# Copy to .env and fill in. .env is gitignored; this template is safe to commit.
# The PAT needs: repo (contents read/write) + workflow (to dispatch the ffmpeg build).

GITHUB_PAT=
GITHUB_OWNER=gbti-network
GITHUB_REPO=minecraft-savepoint-jukebox
GITHUB_REMOTE_SSH=git@github.com:gbti-network/minecraft-savepoint-jukebox.git
GITHUB_REMOTE_HTTPS=https://github.com/gbti-network/minecraft-savepoint-jukebox.git
