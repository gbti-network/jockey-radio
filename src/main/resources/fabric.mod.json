{
	"schemaVersion": 1,
	"id": "travelers_jukebox",
	"version": "${version}",
	"name": "Traveler's Jukebox",
	"description": "Turn any Minecraft jukebox into a live broadcasting endpoint. Play internet radio, livestreams, SoundCloud/Mixcloud, direct audio URLs, and uploaded files through music discs as positional Simple Voice Chat audio. Server-side; with native SavePoint broadcasting integration.",
	"authors": [
		"GBTI Network"
	],
	"contact": {
		"homepage": "https://jukebox.fm",
		"sources": "https://github.com/gbti-network/minecraft-mod-travelers-jukebox",
		"issues": "https://github.com/gbti-network/minecraft-mod-travelers-jukebox/issues"
	},
	"license": "ARR",
	"icon": "assets/travelers_jukebox/icon.png",
	"environment": "server",
	"entrypoints": {
		"main": [
			"fm.savepoint.radio.SavePointRadioMod"
		],
		"voicechat": [
			"fm.savepoint.radio.voicechat.SavePointVoicechatPlugin"
		]
	},
	"mixins": [
		"travelers_jukebox.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "26.2",
		"fabric-command-api-v2": "*",
		"fabric-lifecycle-events-v1": "*",
		"fabric-networking-api-v1": "*",
		"fabric-resource-loader-v1": "*",
		"voicechat": ">=2.6.21"
	}
}
