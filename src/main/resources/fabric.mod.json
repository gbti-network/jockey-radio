{
	"schemaVersion": 1,
	"id": "jockey_radio",
	"version": "${version}",
	"name": "Jockey Radio",
	"description": "Turn any Minecraft jukebox into a live broadcasting endpoint. Play internet radio, livestreams, SoundCloud/Mixcloud, direct audio URLs, and uploaded files through music discs as positional Simple Voice Chat audio. Server-side; with native SavePoint broadcasting integration.",
	"authors": [
		"GBTI"
	],
	"contact": {
		"homepage": "https://github.com/gbti-network/jockey-radio",
		"sources": "https://github.com/gbti-network/jockey-radio",
		"issues": "https://github.com/gbti-network/jockey-radio/issues"
	},
	"license": "ARR",
	"icon": "assets/jockey_radio/icon.png",
	"environment": "server",
	"entrypoints": {
		"main": [
			"fm.gbti.jockey.JockeyRadioMod"
		],
		"voicechat": [
			"fm.gbti.jockey.voicechat.JockeyRadioVoicechatPlugin"
		]
	},
	"mixins": [
		"jockey_radio.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "26.2",
		"fabric-command-api-v2": "*",
		"fabric-lifecycle-events-v1": "*",
		"fabric-networking-api-v1": "*",
		"fabric-resource-loader-v1": "*",
		"voicechat": ">=2.6.21"
	}
}
