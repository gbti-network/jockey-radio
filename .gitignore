.data/
.product/
.server/

# Secrets - never commit. Holds the GitHub PAT used for CI / releases.
.env
.env.*
!.env.example

# Gradle / build output
build/
.gradle/

# .docs/ is local-only working documentation and offline reference material; it is NOT
# published in the repo. It also holds large dumps that must never be committed:
#   minecraft-26.2-sources/  - decompiled Minecraft (PROPRIETARY, ~62 MB)
#   fabric-docs/             - shallow clone of FabricMC/fabric-docs (~197 MB)
#   fabric-api-*-javadoc/    - extracted Fabric API javadoc (~22 MB)
# The technical docs (HOSTING.md etc.) live here too and stay off the public repo.
.docs/

# Local Claude Code config / project instructions (kept out of version control).
.claude/
CLAUDE.md

# Python bytecode / stray logs
__pycache__/
*.pyc
*.log
