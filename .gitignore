.data/
.product/
.server/

# Secrets - never commit. Holds the GitHub PAT used for CI / releases.
.env
.env.*
!.env.example

# Gradle / build output
build/
.gradle/

# .docs/ mixes OUR authored documentation with a large offline reference dump that
# must NEVER be committed or redistributed:
#   minecraft-26.2-sources/  - decompiled Minecraft (PROPRIETARY, ~62 MB)
#   fabric-docs/             - shallow clone of FabricMC/fabric-docs (~197 MB)
#   fabric-api-*-javadoc/    - extracted Fabric API javadoc (~22 MB)
# So ignore .docs/ by default and allow-list only our own files back in.
.docs/*
!.docs/README.md
!.docs/*.html
!.docs/*.css
!.docs/assets/

# Local Claude Code config / project instructions (kept out of version control).
.claude/
CLAUDE.md

# Python bytecode / stray logs
__pycache__/
*.pyc
*.log
